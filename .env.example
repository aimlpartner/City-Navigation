# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# GOOGLE_MAPS_API_KEY: Used for Google Maps Platform JS & APIs
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyC7iYu-rcH75Muc-R5BvZ5mt_lfy9T8dqk"
GOOGLE_MAPS_API_KEY="AIzaSyC7iYu-rcH75Muc-R5BvZ5mt_lfy9T8dqk"

# ---------------------------------------------------------------------------------
# METRO TICKETING CREDENTIALS (ONDC TRANSIT & NATIVE UPI CHECKOUT)
# ---------------------------------------------------------------------------------

# Ticketing execution mode: 'sandbox' (testing without live gates) or 'live' (real DMRC turnstile issuance)
METRO_TICKETING_MODE="sandbox"

# 1. ONDC Mobility Participant Credentials (Buyer App - BAP)
# Register your domain as an ONDC Buyer App or acquire via an ONDC Technology Service Provider (TSP like Juspay/Protean)
ONDC_BAP_ID="metronav.bap.ondc"
ONDC_BAP_URI="https://metronav.in/api/ondc/callback"

# 2. Cryptographic Signing Keypair (Ed25519)
# Registered in ONDC Registry for signing Authorization headers per Beckn specification
ONDC_PUBLIC_KEY="YOUR_ONDC_ED25519_PUBLIC_KEY"
ONDC_PRIVATE_KEY="YOUR_ONDC_ED25519_PRIVATE_KEY"

# 3. Encryption Keypair (X25519) for decrypting sensitive ticket payloads
ONDC_ENCRYPTION_PUBLIC_KEY="YOUR_ONDC_X25519_PUBLIC_KEY"
ONDC_ENCRYPTION_PRIVATE_KEY="YOUR_ONDC_X25519_PRIVATE_KEY"

# 4. ONDC Gateway URL:
# Staging: https://staging.gateway.ondc.org
# Production: https://prod.gateway.ondc.org
ONDC_GATEWAY_URL="https://staging.gateway.ondc.org"

# 5. Merchant UPI Collection Details (Used to construct native upi://pay intents)
MERCHANT_UPI_VPA="dmrc.transit@sbi"
MERCHANT_NAME="MetroNav DMRC Transit"

# 6. Optional Payment Gateway Credentials (If using Razorpay/Cashfree instead of direct UPI VPA)
# RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
